\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces OpenVLA (left) vs.\ $\chi $-VLA\ (right), stage by stage. \textbf  {Green} boxes are tensorized (multilinear) replacements; \textbf  {blue} boxes are the non-polynomial originals they replace; \textbf  {grey} boxes are kept as-is or lie outside the tensor-network boundary. Patchify/embed and the tokenizer are already linear and need no change; the softmax/GELU/LayerNorm blocks (dual ViTs, MLP projector, Llama~2 backbone) and the discrete action decoder are each swapped for a bilinear/CP equivalent with foldable RmsBatchNorm; camera decoding, string tokenization, and safety clipping remain external.}}{7}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:arch}{{1}{7}{OpenVLA (left) vs.\ \chivla \ (right), stage by stage. \textbf {Green} boxes are tensorized (multilinear) replacements; \textbf {blue} boxes are the non-polynomial originals they replace; \textbf {grey} boxes are kept as-is or lie outside the tensor-network boundary. Patchify/embed and the tokenizer are already linear and need no change; the softmax/GELU/LayerNorm blocks (dual ViTs, MLP projector, Llama~2 backbone) and the discrete action decoder are each swapped for a bilinear/CP equivalent with foldable RmsBatchNorm; camera decoding, string tokenization, and safety clipping remain external}{figure.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces The ablation program. Experiments 1--6 each isolate one row of Table~\ref {tab:swaps}; Experiment 7 tests whether the joint payoff (global decomposability) that motivates all the swaps materializes. Suggested dependency order: 1 and 5 first (do we train, and where is the tax); 2/3/4/6 in parallel as cheap variants; 7 only on the winning configuration, ideally at ${\sim }50$M params where exact contraction is feasible.}}{8}{table.caption.10}\protected@file@percent }
\newlabel{tab:program}{{5}{8}{The ablation program. Experiments 1--6 each isolate one row of Table~\ref {tab:swaps}; Experiment 7 tests whether the joint payoff (global decomposability) that motivates all the swaps materializes. Suggested dependency order: 1 and 5 first (do we train, and where is the tax); 2/3/4/6 in parallel as cheap variants; 7 only on the winning configuration, ideally at ${\sim }50$M params where exact contraction is feasible}{table.caption.10}{}}
